# Copy this file to .env for local development and replace placeholders locally.
# Never put real credentials or private keys in this file.

# Application
APP_ENV=development
APP_PORT=3000

# Add project-specific variables below with safe, non-secret example values.
# SERVICE_API_KEY=replace-me-locally

# Local PostgreSQL connectivity test
PGHOST=localhost
PGPORT=5432
PGDATABASE=replace-with-local-database
PGUSER=replace-with-local-user
# Provisioning maintenance connection (passwords are never stored here)
PGADMINDB=postgres
PGADMINUSER=postgres
# Excel mail format template used for Outlook editable tables
# SPW_MAIL_TEMPLATE=C:\path\to\TS IIS信件寄送格式.xlsx
# Never put PGPASSWORD in this example file. The connection test always prompts for it
# without echoing; the inventory importer reads it from your local, Git-ignored .env if
# present and otherwise prompts the same way.
# PGADMINPASSWORD and PGDEVPASSWORD are never stored in any file: set them as shell
# environment variables only for the provisioning run, then clear them.
